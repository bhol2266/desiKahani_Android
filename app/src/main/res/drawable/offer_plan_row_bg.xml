<?xml version="1.0" encoding="utf-8"?>
<!-- Selected-plan row on the offer sheet: a slightly deeper surface with a gold
     edge, so it reads as the thing being bought rather than a plain label. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/gold_wash" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="@color/gold" />
</shape>
