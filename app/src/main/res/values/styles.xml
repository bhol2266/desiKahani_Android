<resources xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="27">

    <!-- ============================================================
         Material 3 theme carrying the warm editorial identity.
         Applied per-activity via the manifest as screens are migrated.
         ============================================================ -->
    <style name="Theme.App.M3" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowDisablePreview">true</item>
        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/gold_soft</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/gold_wash</item>
        <item name="colorOnSecondaryContainer">@color/gold_deep</item>
        <item name="colorSurface">@color/surface_ivory</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/surface_cream</item>
        <item name="colorOnSurfaceVariant">@color/ink_muted</item>
        <item name="colorOutline">@color/divider_warm</item>
        <item name="colorOutlineVariant">@color/divider_warm</item>
        <!-- System bars follow the ivory surface so they read as part of the app,
             with dark icons for contrast. -->
        <item name="android:statusBarColor">@color/surface_ivory</item>
        <item name="android:navigationBarColor">@color/surface_ivory</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
    </style>

    <!-- Screens whose hero artwork runs behind the status bar: light status-bar
         icons so they stay legible over the banner, but dark navigation-bar
         icons because the bottom of the screen is still ivory. -->
    <style name="Theme.App.M3.HeroTop" parent="Theme.App.M3">
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- For the dark, focused media screens (audio players): ink system bars
         with light icons, so the bars match that screen instead of the ivory app. -->
    <style name="Theme.App.M3.Dark" parent="Theme.App.M3">
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Admin console: deliberately a dark, tool-like surface so it reads as
         internal tooling rather than the warm reader app. Built on the Material3
         *Dark* baseline so switches, text fields and buttons get correct
         light-on-dark styling without hand-colouring every control. -->
    <style name="Theme.App.Admin" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowDisablePreview">true</item>
        <item name="colorPrimary">@color/gold</item>
        <item name="colorOnPrimary">#12202E</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorOnSecondary">#12202E</item>
        <item name="colorSurface">@color/admin_card</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/admin_card_alt</item>
        <item name="colorOnSurfaceVariant">@color/admin_text_dim</item>
        <item name="colorOutline">@color/admin_outline</item>
        <item name="colorOutlineVariant">@color/admin_outline</item>
        <item name="colorError">@color/admin_danger</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
    </style>

    <!-- Base application theme for screens not yet migrated to M3.
         Uses the MaterialComponents *Bridge* theme: this supplies the Material
         attributes that MaterialCardView / ShapeableImageView require (they are
         used in shared layouts such as grid_layout.xml, which legacy screens
         inflate) WITHOUT changing default widget inflation - so plain <Button>s
         on legacy screens keep their custom android:background drawables. -->
    <style name="Theme.App" parent="Theme.MaterialComponents.Light.NoActionBar.Bridge">
        <item name="android:windowDisablePreview">true</item>
        <item name="colorPrimaryDark">@color/themeColor</item>
        <item name="colorShadowDark">@color/grey</item>
        <item name="colorShadowLight">@color/white</item>
        <item name="android:statusBarColor">@color/surface_ivory</item>
        <item name="android:navigationBarColor">@color/surface_ivory</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>


    <!-- ============================================================
         Typography.
         Script Devanagari (kalam) for editorial headers/titles,
         robotoslab for structural titles, inter for UI, jaldi for
         long-form story body text.
         ============================================================ -->

    <style name="TextAppearance.Editorial.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/kalam_regular</item>
        <item name="fontFamily">@font/kalam_regular</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="TextAppearance.Editorial.Wordmark" parent="">
        <item name="android:fontFamily">@font/kalam_regular</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">25sp</item>
    </style>

    <style name="TextAppearance.Editorial.SectionHeader" parent="">
        <item name="android:fontFamily">@font/kalam_regular</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">21sp</item>
    </style>

    <style name="TextAppearance.Editorial.Title" parent="">
        <item name="android:fontFamily">@font/robotoslab_regular</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="TextAppearance.Editorial.Body" parent="">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Editorial.StoryBody" parent="">
        <item name="android:fontFamily">@font/jaldi</item>
        <item name="android:textColor">#3E3A33</item>
        <item name="android:textSize">20sp</item>
        <item name="android:lineSpacingExtra">9dp</item>
    </style>

    <style name="TextAppearance.Editorial.Meta" parent="">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/ink_faint</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.Editorial.Badge" parent="">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gold_deep</item>
        <item name="android:textSize">11sp</item>
    </style>


    <!-- ============================================================
         Shapes
         ============================================================ -->

    <style name="ShapeAppearanceOverlay.GridThumbnail" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.StoryCardTop" parent="">
        <item name="cornerFamilyTopLeft">rounded</item>
        <item name="cornerFamilyTopRight">rounded</item>
        <item name="cornerSizeTopLeft">26dp</item>
        <item name="cornerSizeTopRight">26dp</item>
        <item name="cornerFamilyBottomLeft">rounded</item>
        <item name="cornerFamilyBottomRight">rounded</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>


    <!-- ============================================================
         Components
         ============================================================ -->

    <style name="Widget.Editorial.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_ivory</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.Editorial.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_ivory</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider_warm</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Editorial.Button" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/inter</item>
        <item name="backgroundTint">@color/ink</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.Editorial.Button.Gold" parent="Widget.Editorial.Button">
        <item name="backgroundTint">@color/gold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.Editorial.NavLabel" parent="">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink_faint</item>
    </style>

    <style name="TextAppearance.Editorial.NavLabelActive" parent="">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Widget.Editorial.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/gold_soft</item>
        <item name="android:width">74dp</item>
        <item name="android:height">38dp</item>
        <item name="shapeAppearance">@style/ShapeAppearanceOverlay.Pill</item>
    </style>

    <style name="Widget.Editorial.ProgressIndicator" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">@color/gold</item>
        <item name="trackColor">@color/gold_soft</item>
        <item name="trackThickness">3dp</item>
    </style>


    <!-- ============================================================
         Legacy styles retained (referenced by existing layouts)
         ============================================================ -->

    <style name="NavigationDrawerStyle">
        <item name="android:textSize">15dp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:listPreferredItemHeightSmall">40dp</item>
        <item name="listPreferredItemHeightSmall">40dp</item>
        <item name="android:listPreferredItemPaddingLeft">8dp</item>
        <item name="listPreferredItemPaddingLeft">8dp</item>
        <item name="android:listPreferredItemPaddingRight">8dp</item>
        <item name="listPreferredItemPaddingRight">8dp</item>
    </style>

    <style name="GridView_Title">
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">@font/kalam_regular</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>

    <style name="tabText">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
