<?xml version="1.0" encoding="utf-8"?>
<!-- Persistent mini audio-player bar, meant to be <include>d by any activity
     extending BaseActivity. Ids referenced directly by BaseActivity#onResume(). -->
<soup.neumorphism.NeumorphCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomAudioPlayer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:visibility="gone"
    app:neumorph_backgroundColor="@color/surface_ivory"
    app:neumorph_shadowElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/audioTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/currentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="00:00"
                android:textColor="@color/ink_muted"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/playPauseBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@null"
                android:padding="6dp"
                android:src="@drawable/pause" />

            <ImageView
                android:id="@+id/stopBtn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:padding="6dp"
                android:src="@drawable/ic_close_line"
                app:tint="@color/ink_faint" />

        </LinearLayout>

        <SeekBar
            android:id="@+id/bottomSeekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:max="100"
            android:progressTint="@color/gold"
            android:thumbTint="@color/gold_deep" />

        <TextView
            android:id="@+id/totalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="00:00"
            android:textColor="@color/ink_muted"
            android:textSize="11sp" />

    </LinearLayout>

</soup.neumorphism.NeumorphCardView>
