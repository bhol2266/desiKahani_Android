<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="5dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_ivory"
        app:cardCornerRadius="18dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/divider_warm"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/recyclerviewLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="6dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageview"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginVertical="12dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.GridThumbnail"
                app:srcCompat="@drawable/love_book" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titlee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/robotoslab_regular"
                    android:maxLines="2"
                    android:text="Ek Purani Kahani"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/date_recyclerview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:maxLines="1"
                        android:text="2022-20-18"
                        android:textColor="@color/ink_faint"
                        android:textSize="11sp" />

                    <!-- dot separator -->
                    <View
                        android:layout_width="3dp"
                        android:layout_height="3dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/dot_separator" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:alpha="0.55"
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/view" />

                    <TextView
                        android:id="@+id/views"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/inter"
                        android:maxLines="1"
                        android:text="99,999"
                        android:textColor="@color/ink_faint"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <ImageView
                android:id="@+id/delete"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="11dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:srcCompat="@drawable/delete" />

            <ImageView
                android:id="@+id/lock"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="11dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:srcCompat="@drawable/lock" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
