<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="20dp"
    app:cardBackgroundColor="@color/surface_ivory"
    app:cardCornerRadius="26dp"
    app:cardElevation="6dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="18dp">


        <com.google.android.gms.ads.AdView xmlns:ads="http://schemas.android.com/apk/res-auto"
            android:id="@+id/adView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_margin="10dp"
            android:visibility="gone"
            ads:adSize="BANNER"
            ads:adUnitId="@string/BannerAd" />

        <LinearLayout
            android:id="@+id/banner_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />


        <View
            android:layout_width="34dp"
            android:layout_height="2dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@color/gold" />

        <TextView
            android:id="@+id/exitMSG"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="If you Like the app. Please give us a Good Rating"
            android:textColor="@color/ink_muted"
            android:textSize="14sp" />


        <LinearLayout
            android:id="@+id/paymentSupport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:orientation="horizontal">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/exit_button1"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:text="CANCEL"
                android:textColor="@color/ink"
                android:textStyle="bold"
                app:cornerRadius="18dp"
                app:strokeColor="@color/divider_warm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exit_button2"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:text="EXIT"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:backgroundTint="@color/ink"
                app:cornerRadius="18dp" />

        </LinearLayout>

    </LinearLayout>



</com.google.android.material.card.MaterialCardView>

