<?xml version="1.0" encoding="utf-8"?>


<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_sepia"
    tools:context=".StoryPage">

    <LinearLayout
        android:id="@+id/AdsLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <RelativeLayout
            android:id="@+id/deltaRelative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_sepia"
            android:paddingVertical="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/back_arrow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="7dp"
                app:srcCompat="@drawable/back_arrow"
                app:tint="@color/ink" />

            <TextView
                android:id="@+id/title_collection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerInParent="true"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/kalam_regular"
                android:longClickable="true"
                android:text="Full Story"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold" />


            <ImageView
                android:id="@+id/VipLottie"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_centerInParent="true"
                android:layout_marginEnd="14dp"
                android:background="@drawable/vip_pill_bg"
                android:padding="7dp"
                android:src="@drawable/crown" />

        </RelativeLayout>

        <com.google.android.gms.ads.AdView xmlns:ads="http://schemas.android.com/apk/res-auto"
            android:id="@+id/adView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:visibility="gone"
            ads:adSize="BANNER"
            ads:adUnitId="@string/BannerAd"
            ads:layout_constraintBottom_toTopOf="@+id/scrollview_story_text" />

        <LinearLayout
            android:id="@+id/banner_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/deltaRelative" />


        <!-- The "page" of the book -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/scrollview_story_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FCF7EC"
            app:cardCornerRadius="0dp"
            app:cardElevation="3dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.StoryCardTop"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="6dp">

                <!-- Title block with gold rule -->
                <TextView
                    android:id="@+id/storyPage_Title_textview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/kalam_regular"
                    android:gravity="center"
                    android:paddingHorizontal="22dp"
                    android:text="Story Title"
                    android:textColor="@color/ink"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="46dp"
                    android:layout_height="2dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:background="@color/gold" />


                <ScrollView
                    android:id="@+id/scrolltext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="88dp">


                        <TextView
                            android:id="@+id/story_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="12dp"
                            android:fontFamily="@font/jaldi"
                            android:lineSpacingExtra="9dp"
                            android:text="                                                                                                                                                                                                                                                              Loading........"
                            android:textColor="#3E3A33"
                            android:textSize="20sp" />



                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/speakWithWriter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginVertical="12dp"
                            android:fontFamily="@font/inter"
                            android:text="लेखक के साथ बात करे"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            app:backgroundTint="@color/gold"
                            app:cornerRadius="18dp" />

                        <!-- Hidden until a link is actually added (see
                             StoryPage#setStoriesLinksInLayout). It used to default
                             to visible, so a story with no linked parts showed a
                             bare heading with nothing under it. -->
                        <LinearLayout
                            android:id="@+id/storiesInsideparagraph"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="8dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/section_label_chip"
                                android:fontFamily="@font/kalam_regular"
                                android:gravity="center"
                                android:paddingHorizontal="20dp"
                                android:paddingVertical="7dp"
                                android:text="ईश कहानी के कुछ और भाग"
                                android:textColor="@color/ink"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/reportStoryBtn"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter"
                            android:text="Report this story"
                            android:textColor="@color/ink_faint"
                            android:textSize="12sp"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_report_flag"
                            app:iconGravity="textStart"
                            app:iconSize="15dp"
                            app:iconTint="@color/ink_faint" />

                        <!-- Same as above: only revealed once a related story is added. -->
                        <LinearLayout
                            android:id="@+id/relatedStoriesLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingVertical="8dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/section_label_chip"
                                android:fontFamily="@font/kalam_regular"
                                android:gravity="center"
                                android:paddingHorizontal="20dp"
                                android:paddingVertical="7dp"
                                android:text="ऐसी ही कुछ और कहानियाँ"
                                android:textColor="@color/ink"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>


                </ScrollView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


    </LinearLayout>


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButtonMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="22dp"
        android:backgroundTint="@color/ink"
        android:clickable="true"
        android:focusable="true"
        app:elevation="8dp"
        app:fabCustomSize="58dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:maxImageSize="24dp"
        app:srcCompat="@drawable/floatingactionbar"
        app:tint="@color/gold_soft" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButtonCopy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="26dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/surface_ivory"
        android:clickable="true"
        android:focusable="true"
        android:visibility="invisible"
        app:elevation="4dp"
        app:fabSize="mini"
        app:layout_constraintBottom_toTopOf="@+id/floatingActionButtonMain"
        app:layout_constraintRight_toRightOf="parent"
        app:srcCompat="@drawable/floatingbar_copy"
        app:tint="@color/ink"
        tools:ignore="VectorDrawableCompat" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButtonShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="26dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/surface_ivory"
        android:clickable="true"
        android:focusable="true"
        android:visibility="invisible"
        app:elevation="4dp"
        app:fabSize="mini"
        app:layout_constraintBottom_toTopOf="@+id/floatingActionButtonCopy"
        app:layout_constraintRight_toRightOf="parent"
        app:srcCompat="@drawable/floatingbar_share"
        app:tint="@color/ink"
        tools:ignore="VectorDrawableCompat" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButtonText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="26dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/surface_ivory"
        android:clickable="true"
        android:focusable="true"
        android:visibility="invisible"
        app:elevation="4dp"
        app:fabSize="mini"
        app:layout_constraintBottom_toTopOf="@+id/floatingActionButtonShare"
        app:layout_constraintRight_toRightOf="parent"
        app:srcCompat="@drawable/floatingbar_textsize"
        app:tint="@color/ink"
        tools:ignore="VectorDrawableCompat" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionFavouriteButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="26dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/surface_ivory"
        android:clickable="true"
        android:focusable="true"
        android:visibility="invisible"
        app:elevation="4dp"
        app:fabSize="mini"
        app:layout_constraintBottom_toTopOf="@+id/floatingActionButtonText"
        app:layout_constraintRight_toRightOf="parent"
        app:srcCompat="@drawable/favourote_border"
        tools:ignore="VectorDrawableCompat" />


</androidx.constraintlayout.widget.ConstraintLayout>
